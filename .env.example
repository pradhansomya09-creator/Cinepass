# ==============================================================================
# Movie Ticket Booking System - Root Environment Configuration (.env.example)
# ==============================================================================

# Server Port
PORT=5000
NODE_ENV=development

# Frontend Client Origin for CORS
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL with Prisma)
# Default points to local Postgres or Docker container
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/movie_ticket_booking?schema=public

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_32_chars_min_production
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_32_chars_min_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Razorpay Sandbox Credentials (Indian Payments)
# Use 'mock_key_id' and 'mock_key_secret' or actual Razorpay Test Mode keys
RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyId123
RAZORPAY_KEY_SECRET=YourRazorpaySecretKey456
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecret789

# Email Configuration (Nodemailer - leave empty for console/test logger fallback)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="CinePass Movie Booking <no-reply@cinepass.com>"

# Cloudinary (Optional image hosting fallback to curated HD CDN URLs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis (Optional seat-hold cache, falls back to in-memory cache/database holds)
REDIS_URL=redis://localhost:6379

# Seat Hold TTL in minutes
SEAT_HOLD_DURATION_MINUTES=8
