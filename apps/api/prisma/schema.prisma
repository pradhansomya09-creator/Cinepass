generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  GUEST
  USER
  ADMIN
}

enum SeatCategory {
  REGULAR
  PREMIUM
  RECLINER
}

enum SeatStatus {
  AVAILABLE
  HELD
  BOOKED
  BLOCKED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  REFUND_PENDING
  REFUNDED
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  REFUND_PENDING
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model User {
  id                String             @id @default(uuid())
  name              String
  email             String             @unique
  phone             String?
  passwordHash      String
  role              UserRole           @default(USER)
  isEmailVerified   Boolean            @default(false)
  emailVerifyToken  String?
  resetToken        String?
  resetTokenExpiry  DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  bookings          Booking[]
  seatHolds         SeatHold[]
  redemptions       CouponRedemption[]
  reviews           Review[]
  auditLogs         AuditLog[]
  refreshTokens     RefreshToken[]

  @@index([email])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model City {
  id        String    @id @default(uuid())
  name      String    @unique
  state     String
  cinemas   Cinema[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([name])
}

model Cinema {
  id         String   @id @default(uuid())
  name       String
  cityId     String
  city       City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  address    String
  facilities String[] @default([])
  screens    Screen[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([cityId])
}

model Screen {
  id         String   @id @default(uuid())
  name       String
  cinemaId   String
  cinema     Cinema   @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  soundType  String   @default("Dolby Atmos 7.1")
  screenType String   @default("4K Laser IMAX")
  seats      Seat[]
  shows      Show[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([cinemaId])
}

model Seat {
  id            String         @id @default(uuid())
  screenId      String
  screen        Screen         @relation(fields: [screenId], references: [id], onDelete: Cascade)
  rowLabel      String
  seatNumber    Int
  category      SeatCategory   @default(REGULAR)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  showSeats     ShowSeat[]
  bookingSeats  BookingSeat[]
  seatHoldItems SeatHoldItem[]

  @@unique([screenId, rowLabel, seatNumber])
  @@index([screenId])
}

model Movie {
  id                String       @id @default(uuid())
  title             String
  description       String
  durationMinutes   Int
  releaseDate       DateTime
  language          String
  posterUrl         String
  bannerUrl         String
  trailerUrl        String?
  rating            Decimal      @default(0.0) @db.Decimal(3, 1)
  ageClassification String       @default("UA")
  director          String
  cast              String[]     @default([])
  isFeatured        Boolean      @default(false)
  isComingSoon      Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  genres            MovieGenre[]
  shows             Show[]
  reviews           Review[]

  @@index([title])
  @@index([language])
}

model Genre {
  id        String       @id @default(uuid())
  name      String       @unique
  movies    MovieGenre[]
}

model MovieGenre {
  movieId String
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genreId String
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([movieId, genreId])
}

model Show {
  id               String       @id @default(uuid())
  movieId          String
  movie            Movie        @relation(fields: [movieId], references: [id], onDelete: Cascade)
  screenId         String
  screen           Screen       @relation(fields: [screenId], references: [id], onDelete: Cascade)
  startTime        DateTime
  endTime          DateTime
  priceRegular     Decimal      @db.Decimal(10, 2)
  pricePremium     Decimal      @db.Decimal(10, 2)
  priceRecliner    Decimal      @db.Decimal(10, 2)
  bookingOpenTime  DateTime?
  bookingCloseTime DateTime?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  showSeats        ShowSeat[]
  bookings         Booking[]
  seatHolds        SeatHold[]

  @@index([movieId])
  @@index([screenId])
  @@index([startTime])
}

model ShowSeat {
  id            String        @id @default(uuid())
  showId        String
  show          Show          @relation(fields: [showId], references: [id], onDelete: Cascade)
  seatId        String
  seat          Seat          @relation(fields: [seatId], references: [id], onDelete: Cascade)
  status        SeatStatus    @default(AVAILABLE)
  bookingSeatId String?       @unique
  bookingSeat   BookingSeat?  @relation(fields: [bookingSeatId], references: [id], onDelete: SetNull)
  price         Decimal       @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([showId, seatId])
  @@index([showId, status])
}

model SeatHold {
  id        String         @id @default(uuid())
  showId    String
  show      Show           @relation(fields: [showId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String         @unique
  expiresAt DateTime
  createdAt DateTime       @default(now())

  items     SeatHoldItem[]

  @@index([showId])
  @@index([userId])
  @@index([expiresAt])
}

model SeatHoldItem {
  id         String   @id @default(uuid())
  seatHoldId String
  seatHold   SeatHold @relation(fields: [seatHoldId], references: [id], onDelete: Cascade)
  seatId     String
  seat       Seat     @relation(fields: [seatId], references: [id], onDelete: Cascade)

  @@unique([seatHoldId, seatId])
}

model Booking {
  id                 String             @id @default(uuid())
  bookingReference   String             @unique
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  showId             String
  show               Show               @relation(fields: [showId], references: [id], onDelete: Restrict)
  totalAmount        Decimal            @db.Decimal(10, 2)
  discountAmount     Decimal            @default(0.0) @db.Decimal(10, 2)
  finalAmount        Decimal            @db.Decimal(10, 2)
  status             BookingStatus      @default(PENDING)
  couponCode         String?
  cancellationReason String?
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  seats              BookingSeat[]
  payment            Payment?
  ticket             Ticket?
  redemptions        CouponRedemption[]

  @@index([userId])
  @@index([showId])
  @@index([bookingReference])
  @@index([status])
}

model BookingSeat {
  id        String       @id @default(uuid())
  bookingId String
  booking   Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seatId    String
  seat      Seat         @relation(fields: [seatId], references: [id], onDelete: Restrict)
  price     Decimal      @db.Decimal(10, 2)
  category  SeatCategory
  showSeat  ShowSeat?

  @@index([bookingId])
}

model Payment {
  id                String        @id @default(uuid())
  bookingId         String        @unique
  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  method            String?
  rawResponse       Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  refunds           Refund[]

  @@index([razorpayOrderId])
  @@index([status])
}

model Refund {
  id               String   @id @default(uuid())
  paymentId        String
  payment          Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bookingId        String
  amount           Decimal  @db.Decimal(10, 2)
  status           String   @default("PROCESSED")
  razorpayRefundId String?  @unique
  reason           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([paymentId])
}

model Coupon {
  id                String             @id @default(uuid())
  code              String             @unique
  description       String
  discountType      DiscountType
  discountValue     Decimal            @db.Decimal(10, 2)
  minBookingAmount  Decimal            @default(0.0) @db.Decimal(10, 2)
  maxDiscountAmount Decimal?           @db.Decimal(10, 2)
  globalUsageLimit  Int                @default(100)
  currentUsageCount Int                @default(0)
  perUserUsageLimit Int                @default(1)
  validFrom         DateTime
  validUntil        DateTime
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  redemptions       CouponRedemption[]

  @@index([code])
}

model CouponRedemption {
  id              String   @id @default(uuid())
  couponId        String
  coupon          Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId       String
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  discountApplied Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now())

  @@index([couponId])
  @@index([userId])
}

model Ticket {
  id           String    @id @default(uuid())
  bookingId    String    @unique
  booking      Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ticketNumber String    @unique
  qrToken      String    @unique
  isRedeemed   Boolean   @default(false)
  redeemedAt   DateTime?
  redeemedBy   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([qrToken])
  @@index([ticketNumber])
}

model Review {
  id        String   @id @default(uuid())
  movieId   String
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([movieId])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
}
